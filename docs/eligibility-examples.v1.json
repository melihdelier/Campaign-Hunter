    {
      "id": "qnb-terminal-kadikoy-restoran",
      "title": "QNB Terminal Kadıköy restoranlarında %10'dan başlayan indirim (First Plus %15, Private %20)",
      "source": "https://www.qnbcard.com.tr/kampanyalar/qnb-terminal-kadikoy-restoran-harcamalarinda-10dan-baslayan-indirim-42833",
      "comment": "Card eligibility and reward tier are SEPARATE decisions. Eligibility: any QNB credit card. Tier: qnb_segment private -> 20%, first_plus -> 15%, otherwise (always) -> 10%. Unknown segment -> the ACTUAL reward is the guaranteed 10%; 20%/15% are only CONDITIONAL. Today the crawler override encodes only the Private case via segmentLabels ['Private'], so a non-Private QNB cardholder sees nothing.",
      "eligibilitySchemaVersion": 1,
      "eligibilityRule": {
        "payWith": {
          "banks": [
            "qnb"
          ]
        }
      },
      "rewardVariants": [
        {
          "when": {
            "attr": {
              "dim": "qnb_segment",
              "in": [
                "private"
              ]
            }
          },
          "rewardRule": {
            "kind": "percent",
            "rate": 0.2,
            "minSpend": 0,
            "perTransactionCap": 1000
          },
          "periodCap": 2000
        },
        {
          "when": {
            "attr": {
              "dim": "qnb_segment",
              "in": [
                "first_plus"
              ]
            }
          },
          "rewardRule": {
            "kind": "percent",
            "rate": 0.15,
            "minSpend": 0,
            "perTransactionCap": 1000
          },
          "periodCap": 2000
        },
        {
          "when": {
            "always": true
          },
          "rewardRule": {
            "kind": "percent",
            "rate": 0.1,
            "minSpend": 0,
            "perTransactionCap": 1000
          },
          "periodCap": 2000
        }
      ],
      "expect": [
        {
          "payWith": "qnb-ms-private",
          "attributes": {
            "qnb_segment": "private"
          },
          "eligible": true
        },
        {
          "payWith": "qnb-ms-private",
          "attributes": {
            "qnb_segment": "first_plus"
          },
          "eligible": true
        },
        {
          "payWith": "qnb-ms-private",
          "attributes": {
            "qnb_segment": "first"
          },
          "eligible": true
        },
        {
          "payWith": "qnb-ms-private",
          "attributes": {},
          "eligible": true
        },
        {
          "payWith": "teb-infinite",
          "attributes": {
            "qnb_segment": "private"
          },
          "eligible": false
        }
      ],
      "rewardExpect": [
        {
          "payWith": "qnb-ms-private",
          "attributes": {
            "qnb_segment": "private"
          },
          "status": "actual",
          "actualRate": 0.2,
          "conditionalRates": []
        },
        {
          "payWith": "qnb-ms-private",
          "attributes": {
            "qnb_segment": "first_plus"
          },
          "status": "actual",
          "actualRate": 0.15,
          "conditionalRates": []
        },
        {
          "payWith": "qnb-ms-private",
          "attributes": {
            "qnb_segment": "first"
          },
          "status": "actual",
          "actualRate": 0.1,
          "conditionalRates": []
        },
        {
          "payWith": "qnb-ms-private",
          "attributes": {
            "qnb_segment": "other"
          },
          "status": "actual",
          "actualRate": 0.1,
          "conditionalRates": []
        },
        {
          "payWith": "qnb-ms-private",
          "attributes": {},
          "status": "actual",
          "actualRate": 0.1,
          "conditionalRates": [
            0.2,
            0.15
          ]
        },
        {
          "payWith": "teb-infinite",
          "attributes": {
            "qnb_segment": "private"
          },
          "status": "ineligible",
          "actualRate": null,
          "conditionalRates": []
        }
      ]
    },
    {
      "id": "qnb-sarj-parapuan",
      "title": "QNB Bireysel Kredi Kartı ile şarjda 50 TL ParaPuan — Miles&Smiles QNB ve QNB Fix hariç",
      "source": "https://www.qnbcard.com.tr/kampanyalar/sarj",
      "comment": "Exclusion (NOT). 'qnb-fix' is not in the master data yet (only six products exist); it will be added to the exclusion list when the product catalog is expanded. Today the crawler drops this campaign entirely; with the schema it can be stored and correctly NOT shown to a Miles&Smiles QNB holder.",
      "eligibilitySchemaVersion": 1,
      "eligibilityRule": {
        "all": [
          {
            "payWith": {
              "banks": [
                "qnb"
              ]
            }
          },
          {
            "not": {
              "payWith": {
                "cards": [
                  "qnb-ms-private"
                ]
              }
            }
          }
        ]
      },
      "expect": [
        {
          "payWith": "qnb-ms-private",
          "attributes": {
            "qnb_segment": "private"
          },
          "eligible": false
        }
      ]
    },
