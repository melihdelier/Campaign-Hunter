{
  "schemaVersion": 1,
  "note": "v1 schema (frozen for v1.5 dual-write). Representative real campaigns expressed in the v1 eligibility schema; only stable codes. 'eligibilityRule' is evaluated by web/eligibility.js today. 'rewardVariants' selection semantics are defined and tested (selectRewardVariant / resolveCampaignReward) but NOT yet wired into the Hangi Kart? amount. 'expect' = eligibility per probe; 'rewardExpect' = which variant is ACTUAL (rate) and which are only CONDITIONAL.",
  "examples": [
    {
      "id": "official-teb-infinite-restoran-ultra",
      "title": "TEB Infinite — Otel/Restoran İndirimi (core benefit)",
      "source": "https://www.teb.com.tr/kart-dunyasi-otel-restoran-indirimi/",
      "eligibilitySchemaVersion": 1,
      "eligibilityRule": {
        "all": [
          {
            "payWith": {
              "cards": [
                "teb-infinite"
              ]
            }
          },
          {
            "attr": {
              "dim": "teb_tier",
              "in": [
                "standard",
                "plus",
                "premium",
                "ultra"
              ]
            }
          }
        ]
      },
      "rewardVariants": [
        {
          "when": {
            "attr": {
              "dim": "teb_tier",
              "in": [
                "standard"
              ]
            }
          },
          "rewardRule": {
            "kind": "percent",
            "rate": 0.05,
            "minSpend": 1500,
            "perTransactionCap": 75
          },
          "periodCap": 250
        },
        {
          "when": {
            "attr": {
              "dim": "teb_tier",
              "in": [
                "plus"
              ]
            }
          },
          "rewardRule": {
            "kind": "percent",
            "rate": 0.1,
            "minSpend": 1500,
            "perTransactionCap": 500
          },
          "periodCap": 2500
        },
        {
          "when": {
            "attr": {
              "dim": "teb_tier",
              "in": [
                "premium"
              ]
            }
          },
          "rewardRule": {
            "kind": "percent",
            "rate": 0.15,
            "minSpend": 1500,
            "perTransactionCap": 1000
          },
          "periodCap": 4000
        },
        {
          "when": {
            "attr": {
              "dim": "teb_tier",
              "in": [
                "ultra"
              ]
            }
          },
          "rewardRule": {
            "kind": "percent",
            "rate": 0.2,
            "minSpend": 1500,
            "perTransactionCap": 2000
          },
          "periodCap": 8000
        }
      ],
      "expect": [
        {
          "payWith": "teb-infinite",
          "attributes": {
            "teb_tier": "ultra"
          },
          "eligible": true
        },
        {
          "payWith": "teb-infinite",
          "attributes": {},
          "eligible": null
        },
        {
          "payWith": "qnb-ms-private",
          "attributes": {
            "teb_tier": "ultra"
          },
          "eligible": false
        }
      ],
      "rewardExpect": [
        {
          "payWith": "teb-infinite",
          "attributes": {
            "teb_tier": "premium"
          },
          "status": "actual",
          "actualRate": 0.15,
          "conditionalRates": []
        },
        {
          "payWith": "teb-infinite",
          "attributes": {},
          "status": "eligibility_unknown",
          "actualRate": null,
          "conditionalRates": [
            0.05,
            0.1,
            0.15,
            0.2
          ]
        }
      ]
    },
